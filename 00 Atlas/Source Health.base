filters:
  and:
    - file.inFolder("01 Episodes")
    - type == "episode"
properties:
  note.osf_number:
    displayName: "OSF #"
  note.ingestion_status:
    displayName: Ingestion
  note.source_status:
    displayName: Source
  note.source_revision:
    displayName: Current revision
  note.schema_version:
    displayName: Schema
  note.parser_version:
    displayName: Parser
views:
  - type: table
    name: Failures
    filters:
      and:
        - ingestion_status == "failed"
    order:
      - osf_number
      - file.name
      - ingestion_status
      - source_status
      - source_revision
    sort:
      - property: osf_number
        direction: ASC
  - type: table
    name: Pending
    filters:
      and:
        - ingestion_status != "complete"
        - ingestion_status != "failed"
    order:
      - osf_number
      - file.name
      - ingestion_status
      - source_status
      - source_revision
    sort:
      - property: osf_number
        direction: ASC
  - type: table
    name: Complete
    filters:
      and:
        - ingestion_status == "complete"
    order:
      - osf_number
      - file.name
      - source_status
      - source_revision
      - schema_version
      - parser_version
    sort:
      - property: osf_number
        direction: ASC
  - type: table
    name: All Episodes
    order:
      - osf_number
      - file.name
      - ingestion_status
      - source_status
      - source_revision
      - schema_version
      - parser_version
    sort:
      - property: osf_number
        direction: ASC

filters:
  and:
    - file.inFolder("02 Entities")
    - type == "entity"
properties:
  note.canonical_name:
    displayName: Entity
  note.entity_type:
    displayName: Type
  note.first_seen:
    displayName: First seen
  note.aliases:
    displayName: Aliases
views:
  - type: table
    name: All Entities
    order:
      - canonical_name
      - entity_type
      - first_seen
      - aliases
      - file.name
    sort:
      - property: canonical_name
        direction: ASC
  - type: table
    name: Unclassified
    filters:
      and:
        - entity_type == "unknown"
    order:
      - canonical_name
      - first_seen
      - aliases
    sort:
      - property: first_seen
        direction: ASC
      - property: canonical_name
        direction: ASC
  - type: table
    name: Places
    filters:
      and:
        - entity_type == "place"
    order:
      - canonical_name
      - first_seen
      - aliases
    sort:
      - property: first_seen
        direction: ASC
      - property: canonical_name
        direction: ASC
  - type: table
    name: Organizations
    filters:
      and:
        - entity_type == "organization"
    order:
      - canonical_name
      - first_seen
      - aliases
    sort:
      - property: first_seen
        direction: ASC
  - type: table
    name: Systems
    filters:
      and:
        - entity_type == "system"
    order:
      - canonical_name
      - first_seen
      - aliases
    sort:
      - property: first_seen
        direction: ASC
  - type: table
    name: Phenomena
    filters:
      and:
        - entity_type == "phenomenon"
    order:
      - canonical_name
      - first_seen
      - aliases
    sort:
      - property: first_seen
        direction: ASC
  - type: table
    name: People
    filters:
      and:
        - entity_type == "person"
    order:
      - canonical_name
      - first_seen
      - aliases
    sort:
      - property: first_seen
        direction: ASC

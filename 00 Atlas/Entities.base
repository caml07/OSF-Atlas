filters:
  and:
    - file.inFolder("02 Entities")
    - 'type == "entity"'

properties:
  note.canonical_name:
    displayName: "Entity"
  note.entity_type:
    displayName: "Type"
  note.first_seen:
    displayName: "First seen"
  note.aliases:
    displayName: "Aliases"

views:
  - type: table
    name: "All Entities"
    order:
      - note.canonical_name
      - note.entity_type
      - note.first_seen
      - note.aliases
      - file.name
    sort:
      - property: note.canonical_name
        direction: ASC

  - type: table
    name: "Places"
    filters:
      and:
        - 'entity_type == "place"'
    order:
      - note.canonical_name
      - note.first_seen
      - note.aliases
    sort:
      - property: note.first_seen
        direction: ASC
      - property: note.canonical_name
        direction: ASC

  - type: table
    name: "Organizations"
    filters:
      and:
        - 'entity_type == "organization"'
    order:
      - note.canonical_name
      - note.first_seen
      - note.aliases
    sort:
      - property: note.first_seen
        direction: ASC

  - type: table
    name: "Systems"
    filters:
      and:
        - 'entity_type == "system"'
    order:
      - note.canonical_name
      - note.first_seen
      - note.aliases
    sort:
      - property: note.first_seen
        direction: ASC

  - type: table
    name: "Phenomena"
    filters:
      and:
        - 'entity_type == "phenomenon"'
    order:
      - note.canonical_name
      - note.first_seen
      - note.aliases
    sort:
      - property: note.first_seen
        direction: ASC

  - type: table
    name: "People"
    filters:
      and:
        - 'entity_type == "person"'
    order:
      - note.canonical_name
      - note.first_seen
      - note.aliases
    sort:
      - property: note.first_seen
        direction: ASC
